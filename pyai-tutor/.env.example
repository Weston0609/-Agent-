# 复制为 .env 并按需填写。系统离线学习阶段不需要任何密钥。

# —— DeepSeek（仅在"系统更新"阶段烧 token）——
DEEPSEEK_API_KEY=sk-替换成你自己的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 每月 token 预算上限（0 = 不限）。超限后更新管道不再发起在线生成。
MONTHLY_TOKEN_BUDGET=6000000

# —— 本地 Ollama（离线 0 token 的推理引擎，可选）——
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# —— 学习参数 ——
LESSON_MINUTES=40
PASS_THRESHOLD=0.75
LESSONS_PER_DAY=3
LEARNING_START_HOUR=8
LEARNING_END_HOUR=22

# —— 数据路径 ——
DATA_DIR=data
